# Copy to .env and fill in. Never commit .env.

# --- Mode ---
# Dry-run is the default. Live side effects require AXOM_LIVE=true, which must
# stay off until the owner's legal review (see README) is complete.
AXOM_LIVE=false

# --- Policy and cap ---
MONTHLY_PAYOUT_CAP_USD=500
PAYOUT_APPROVAL_THRESHOLD_USD=50
AXOM_POLICY_PATH=config/policy.toml

# --- Database (self-hosted Supabase Postgres) ---
DATABASE_URL=postgres://axom:axom@localhost:5432/axom
SUPABASE_URL=

# --- Planner ---
AXOM_MASTER_PLAN_PATH=config/master_plan.json
AXOM_PLANNER_CONFIG_PATH=config/planner.toml
AXOM_PERFORMANCE_CONFIG_PATH=config/performance.toml

# --- Owner notifications ---
AXOM_OWNER_EMAIL=
AXOM_DASHBOARD_URL=http://localhost:3000

# --- API ---
AXOM_API_BIND=0.0.0.0:8080

# --- NEAR ---
# testnet unless set to mainnet explicitly (mainnet also needs AXOM_LIVE=true).
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_PRICE_FEED_URL=https://api.coingecko.com/api/v3/simple/price?ids=near&vs_currencies=usd
NEAR_PRICE_FEED_POINTER=/near/usd
# CoinGecko rejects unauthenticated calls at times; set a (free demo) API key.
NEAR_PRICE_FEED_API_KEY=
NEAR_PRICE_FEED_API_KEY_HEADER=x-cg-demo-api-key

# --- Cross-chain payouts: NEAR Intents (axom-signer) ---
# 1click (mainnet only), simulated (testnet only: the NEAR deposit is real,
# the solver is simulated), or off. Default: 1click on mainnet, simulated on testnet.
# AXOM_INTENTS=
AXOM_INTENTS_API_URL=https://1click.chaindefuser.com
# Optional 1Click partner key (sent as X-API-Key). Without it 1Click adds its platform fee.
AXOM_INTENTS_API_KEY=
# `axom intents-quote` only: refund account for dry quotes (any plain NEAR account).
# AXOM_INTENTS_DRY_REFUND_TO=

# --- Treasury yield on Rhea Finance lending (axom-signer) ---
# Platform default: overrides [treasury] yield_enabled in config/policy.toml
# when "true". Each company turns yield on or off in Settings (Treasury
# yield); that choice wins over this default.
# TREASURY_YIELD_ENABLED=

# --- Authorization keys (generate with `axom keygen`) ---
# Seeds are secrets: attestation seed for axom, approval seed for the API.
AXOM_ATTESTATION_SIGNING_KEY=
AXOM_APPROVAL_SIGNING_KEY=
# Verify keys (ed25519:<base58>) for axom-signer.
AXOM_ATTESTATION_VERIFY_KEY=
AXOM_APPROVAL_VERIFY_KEY=

# --- Supabase Auth (approval API) ---
# Asymmetric signing keys (newer projects): <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Legacy shared secret (HS256). Both may be set during a key migration.
SUPABASE_JWT_SECRET=

# --- OpenBao (axom-signer only) ---
# Docker (./scripts/start) uses its own OpenBao and ignores this; set
# AXOM_DOCKER_OPENBAO_ADDR there to use another one. For scripts/dev.sh.
OPENBAO_ADDR=
# The signer's token (./scripts/setup writes it here). Kept in this file's
# environment only, never in a token file; only the signer is given it.
OPENBAO_TOKEN=
OPENBAO_TRANSIT_KEY=axom-treasury
AXOM_SIGNER_BIND=127.0.0.1:8090
# Where the API asks the signer for the treasury address it shows on the
# dashboard (read-only). scripts/dev.sh sets it when it starts the signer,
# and Docker ignores it (./scripts/start points the API at the signer's
# container when payouts are set up). Set it only for a signer elsewhere.
AXOM_SIGNER_URL=

# --- Tool adapters (dry-run unless AXOM_LIVE=true) ---
AXOM_INTERNAL_TOKEN=
DOCUSEAL_URL=
DOCUSEAL_API_KEY=
# Owner-approved templates only: name=docuseal_template_id,...
DOCUSEAL_TEMPLATES=freelancer-services-v1=1,termination-notice-v1=2,tax-form-w9=3,tax-form-w8ben=4
# opendesk (opendesk.sh), where meeting summaries are filed as notes on the
# person's contact. CRM_API_KEY: a workspace API key (od_live_...) with the
# contacts:read and contacts:write scopes. CRM_URL: empty for the hosted
# service (https://api.opendesk.sh), or your self-hosted opendesk's API URL.
CRM_URL=
CRM_API_KEY=
# AI workers' tools (crm, postiz, warmbly, code_repo, web_research, ...) are
# MCP servers or webhooks connected on the dashboard's Tools page, named
# after the tool. Tasks that need one that isn't connected wait for it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Meetings (LiveKit, bundled with Combox) ---
# docker compose starts LiveKit and the AI interviewer for you; leave these
# empty locally. On a server (infra/coolify/axom.yml) set the public wss://
# address browsers use and a key pair of your own (secret: 32+ characters).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AXOM_PUBLIC_API_URL=http://localhost:8080
# Where the meeting agent reaches the API, if not AXOM_PUBLIC_API_URL
# (Docker Compose sets http://axom:8080).
AXOM_AGENT_CALLBACK_URL=
AXOM_MEET_WEB_URL=http://localhost:5173
AXOM_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Meeting agent providers (meet-agent service). Deepgram does all voice
# (speech-to-text and text-to-speech) with one key.
DEEPGRAM_API_KEY=
# Optional Deepgram voice/model overrides, e.g. aura-2-thalia-en / nova-3.
AXOM_MEET_TTS_VOICE=
AXOM_MEET_STT_MODEL=
# Optional: AXOM_MEET_TTS=cartesia switches text-to-speech to Cartesia
# (needs CARTESIA_API_KEY and the image built with EXTRAS=cartesia).
AXOM_MEET_TTS=deepgram
CARTESIA_API_KEY=
AXOM_MEET_LLM_MODEL=claude-sonnet-5-5

# --- AI workers ---
# With an Anthropic key, AI workers think: Claude reads each task, calls the
# worker's allowed tools (policy-checked), and writes up the result. Without
# one, workers just run the task's tools. The interviewer uses this key too.
# Companies can set their own key on the dashboard's Integrations page.
ANTHROPIC_API_KEY=
# Optional: AXOM_AI_MODEL=claude-opus-5-5
# Optional: ANTHROPIC_BASE_URL=https://your-proxy.example.com

# --- MCP server (meeting tools only) ---
AXOM_MCP_TOKEN=

# --- Admin dashboard (admin/, build-time) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AXOM_API_URL=http://localhost:8080

# --- Hiring marketplace ---
# board (default): Combox Jobs, the built-in public jobs board; hires are paid in NEAR.
# upwork: post to Upwork; those hires are paid through Upwork, never in NEAR.
AXOM_MARKETPLACE=board

# --- Upwork (hosted freelancing MCP; only with AXOM_MARKETPLACE=upwork) ---
UPWORK_MCP_URL=
UPWORK_MCP_TOKEN=
UPWORK_MCP_TOOL_POST_JOB=post_job
UPWORK_MCP_TOOL_LIST_APPLICANTS=list_applicants
UPWORK_MCP_TOOL_MESSAGE=message_candidate

# --- Multi-tenant platform (optional) ---
# true: run Combox as a platform where anyone can sign up companies. Each company
# gets its own database; DATABASE_URL is then the PLATFORM database (its role
# needs CREATEDB). Leave false for one company per deployment.
AXOM_MULTI_TENANT=false
# Master key for companies' integration keys (AES-256-GCM). Generate with:
#   docker compose run --rm --no-deps axom axom secrets-key
# Losing it makes stored integration keys unreadable; keep a backup offline.
AXOM_SECRETS_KEY=
# Subscription: one plan, priced in USD, paid in NEAR to this account.
AXOM_BILLING_ACCOUNT=
AXOM_PLAN_NAME=Combox
AXOM_PLAN_PRICE_USD=49
AXOM_TRIAL_DAYS=14
# OpenBao token with the provisioner policy (infra/openbao/axom-provisioner.hcl):
# creates each company's treasury key; can't sign, export, or delete keys.
# Environment only, never a token file; only the API is given it.
OPENBAO_PROVISIONER_TOKEN=
# Platform operators (comma-separated emails): see every company and can suspend
# or resume one, in the dashboard's "All companies" page (two-factor required).
AXOM_PLATFORM_OPERATORS=
# Dashboard build: where the candidate site lives (jobs board links).
VITE_AXOM_MEET_WEB_URL=http://localhost:5173

# --- Custom tools (MCP servers and webhooks admins add in the dashboard) ---
# Tool tokens are encrypted with AXOM_SECRETS_KEY (set it in single-company mode
# too if admins will add tools with tokens, or save integration keys on the
# dashboard's Integrations page; a key saved there replaces the value here). Tools may only reach public HTTPS
# addresses. true lets a single-company deployment reach its own internal
# services (plain http, private addresses); ignored on the multi-tenant platform.
AXOM_TOOLS_ALLOW_PRIVATE=false

# --- Operations ---
# Turn off the hourly payroll run (judge mode sets this for its API server).
AXOM_DISABLE_PAYROLL=false

# --- Judge mode only (set by judge/run.sh; never on the VPS) ---
# AXOM_ROOT=.
# AXOM_DEMO_USD_PER_NEAR=1000      # testnet-only pinned rate so faucet funds cover the demo
# AXOM_DEMO_API_PORT=18181
# AXOM_DEMO_WAIT_SECS=180
# AXOM_JUDGE_ADMIN_ID=
# VITE_JUDGE_MODE=true              # dashboard accepts ./judge/token.sh tokens
# Test-only: AXOM_TEST_BAO_BIN=/path/to/bao   (real-OpenBao tests)
# Testnet top-up example only: COLD_KEY_FILE, COLD_ACCOUNT, TO, AMOUNT_NEAR

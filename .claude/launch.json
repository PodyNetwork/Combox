{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "axom-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "scripts/dev.sh"
      ],
      "cwd": ".",
      "port": 5174
    },
    {
      "name": "axom-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "dev"
      ],
      "cwd": ".",
      "port": 5175
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "site", "run", "preview", "--", "--port", "4175", "--strictPort"],
      "cwd": ".",
      "port": 4175
    }
  ]
}

#!/usr/bin/env bash
# Set up your own Combox (Docker, one company): asks for your Supabase
# details, writes .env (keys are generated for you), then starts it with
# ./scripts/start. Safe to run again: values already in .env are kept.
#
#   ./scripts/setup          set up, then start
#   ./scripts/setup payouts  only set up payouts (OpenBao and the signer);
#                            ./scripts/start runs this when they aren't yet
#
# After that, ./scripts/start starts it and ./scripts/stop stops it.
#
# Before the first run, create a free Supabase project (supabase.com) with
# two-factor (TOTP) turned on and a user for yourself. Click-by-click steps:
# docs/SETUP.md, step 2.
# You become the dashboard's admin the first time you sign in with that
# email and the two-factor code.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
ENV="$ROOT/.env"

say() { printf '\033[1m%s\033[0m\n' "$*"; }
step() { printf '\n\033[1m%s\033[0m\n' "$*"; }
fail() { printf '\n\033[1;31m%s\033[0m\n' "$1" >&2; shift; for l in "$@"; do echo "$l" >&2; done; exit 1; }

get_env() { grep -E "^$1=" "$ENV" 2>/dev/null | tail -1 | cut -d= -f2- || true; }
# Replace KEY=... in .env (or append it). awk + ENVIRON: values are taken
# literally, whatever characters they contain.
set_env() {
  K="$1" V="$2" awk 'BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"]; done = 0 }
    index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }' "$ENV" > "$ENV.tmp"
  mv "$ENV.tmp" "$ENV"; chmod 600 "$ENV"
}
ask() { # ask VAR "Question" [default]
  local answer
  if [[ -n "${3:-}" ]]; then read -r -p "$2 [$3]: " answer; answer="${answer:-$3}"
  else read -r -p "$2: " answer; fi
  printf -v "$1" '%s' "$(echo "$answer" | tr -d '[:space:]')"
}

ensure_docker() {
  command -v docker >/dev/null || fail "Docker isn't installed." "Install Docker Desktop: https://www.docker.com/products/docker-desktop/"
  docker compose version >/dev/null 2>&1 || fail "Docker Compose isn't available." "Update Docker Desktop (it includes 'docker compose')."
  docker info >/dev/null 2>&1 && return 0
  if [[ "$(uname -s)" == Darwin ]] && open -Ra Docker 2>/dev/null; then
    echo "Docker isn't running; starting Docker Desktop..."
    open -a Docker
    for _ in $(seq 1 90); do docker info >/dev/null 2>&1 && return 0; sleep 2; done
  fi
  fail "Docker isn't running." "Start Docker Desktop and run ./scripts/setup again."
}

# --- Payouts (NEAR testnet) ---------------------------------------------------------
# OpenBao (in Docker, payouts profile) holds the treasury key; the signer is
# the only part of Combox that can use it. Done once. The signer's token is
# kept in .env as OPENBAO_TOKEN (git-ignored, only the signer container gets
# it), never in a file of its own. OpenBao's unseal key is kept in secrets/
# (git-ignored), so ./scripts/start can unseal OpenBao after a restart: fine
# for testnet on your own machine. For mainnet, use a separate OpenBao you
# unseal by hand (infra/coolify/).
LEGACY_SIGNER_TOKEN="$ROOT/secrets/openbao_signer_token"   # older setups; moved into .env
UNSEAL_KEY="$ROOT/secrets/openbao_unseal_key"
bao() { # the bao CLI inside the OpenBao container
  local e=(-e BAO_ADDR=http://127.0.0.1:8200)
  [[ -n "${BAO_TOKEN:-}" ]] && e+=(-e "BAO_TOKEN=$BAO_TOKEN")
  docker compose --profile payouts exec -T "${e[@]}" openbao bao "$@"
}
# Sets up OpenBao and the signer's token, once. ./scripts/start runs it too
# (./scripts/setup payouts), so payouts are on without a separate step.
setup_payouts() {
  local root_token=""
  mkdir -p "$ROOT/secrets"
  # Older setups kept the token in its own file: move it into .env.
  if [[ -z "$(get_env OPENBAO_TOKEN)" && -s "$LEGACY_SIGNER_TOKEN" ]]; then
    set_env OPENBAO_TOKEN "$(tr -d '[:space:]' < "$LEGACY_SIGNER_TOKEN")"
    echo "Moved the signer's OpenBao token from secrets/openbao_signer_token into .env (OPENBAO_TOKEN)."
  fi
  [[ -n "$(get_env OPENBAO_TOKEN)" ]] && rm -f "$LEGACY_SIGNER_TOKEN"
  # An older setup interrupted halfway left its admin token in a file: use it
  # (in memory) to finish, and delete the file either way.
  if [[ -s "$ROOT/secrets/openbao_root_token" && -z "$(get_env OPENBAO_TOKEN)" ]]; then
    root_token="$(tr -d '[:space:]' < "$ROOT/secrets/openbao_root_token")"
  fi
  rm -f "$ROOT/secrets/openbao_root_token"
  if [[ -n "$(get_env OPENBAO_TOKEN)" ]]; then
    :
  elif [[ "$(get_env NEAR_NETWORK)" == mainnet ]]; then
    echo "NEAR_NETWORK=mainnet: payouts need an OpenBao you unseal by hand (infra/coolify/openbao.yml); skipping them here."
  else
    step "Setting up payouts (NEAR testnet)"
    docker compose --profile payouts up -d openbao
    # bao status exits 0 (unsealed), 2 (sealed) or 1 (not answering yet).
    local st=1 status init out treasury token
    for _ in $(seq 1 30); do st=0; bao status >/dev/null 2>&1 || st=$?; [[ "$st" != 1 ]] && break; sleep 1; done
    [[ "$st" != 1 ]] || fail "OpenBao didn't start." "See its log: docker compose --profile payouts logs openbao"

    status="$(bao status -format=json 2>/dev/null || true)"   # exits 2 while sealed
    if echo "$status" | tr -d ' \n' | grep -q '"initialized":false'; then
      init="$(bao operator init -key-shares=1 -key-threshold=1 -format=json | tr -d ' \n')"
      (umask 077; echo "$init" | sed -n 's/.*"unseal_keys_b64":\["\([^"]*\)".*/\1/p' > "$UNSEAL_KEY")
      # The admin (root) token is only needed for the next few steps: it
      # stays in memory and is revoked at the end, never written to disk.
      root_token="$(echo "$init" | sed -n 's/.*"root_token":"\([^"]*\)".*/\1/p')"
      unset init
    fi
    [[ -s "$UNSEAL_KEY" && -n "$root_token" ]] || fail "OpenBao is already set up, but OPENBAO_TOKEN is missing from .env." \
      "Put back OPENBAO_TOKEN from your backup of .env and run ./scripts/setup again." \
      "Or start payouts over on testnet (a new, empty treasury): docker compose --profile payouts rm -sf openbao; docker volume rm $(basename "$ROOT" | tr '[:upper:]' '[:lower:]')_openbao-data; rm secrets/openbao_unseal_key"
    bao operator unseal "$(cat "$UNSEAL_KEY")" >/dev/null

    # The same setup as on a server, run with the bao above.
    export -f bao
    out="$(BAO_TOKEN="$root_token" "$ROOT/infra/openbao/setup-treasury.sh")"
    treasury="$(echo "$out" | grep -A1 'implicit account' | tail -1)"
    token="$(echo "$out" | tail -1 | tr -d '[:space:]')"; unset out
    [[ -n "$token" ]] || fail "Creating the signer's OpenBao token failed." "Run ./scripts/setup again."
    set_env OPENBAO_TOKEN "$token"; unset token
    # The signer's token is all Combox needs: retire the admin token.
    BAO_TOKEN="$root_token" bao token revoke -self >/dev/null; unset root_token
    say "Payouts are set up. Treasury (NEAR testnet): $treasury"
    echo "Fund it with ./scripts/fund-testnet once Combox is running (faucets refuse a new treasury). The dashboard shows it too."
    echo "Back up .env (OPENBAO_TOKEN) and the secrets/ folder: without them, the treasury key can't be used."
  fi
}

MODE=all
case "${1:-}" in
  "") ;;
  payouts) MODE=payouts ;;
  -h|--help|help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
  *) fail "Unknown option: $1" "Run ./scripts/setup --help to see the options." ;;
esac

command -v curl >/dev/null || fail "curl isn't installed." "Install curl with your package manager."
ensure_docker

if [[ "$MODE" == payouts ]]; then
  [[ -f "$ENV" ]] || fail "No .env file." "Run ./scripts/setup first."
  setup_payouts
  exit 0
fi

# --- 1. .env -------------------------------------------------------------------
[[ -f "$ENV" ]] || { cp "$ROOT/.env.example" "$ENV"; chmod 600 "$ENV"; }
mkdir -p "$ROOT/secrets"

if [[ -z "$(get_env SUPABASE_URL)" || -z "$(get_env VITE_SUPABASE_ANON_KEY)" || -z "$(get_env AXOM_OWNER_EMAIL)" ]]; then
  step "Supabase (sign-in for the dashboard)"
  echo "In your Supabase project, under Project Settings: the Project URL is on"
  echo "the Data API page, the key on the API Keys page. Haven't set up Supabase"
  echo "yet? Follow docs/SETUP.md, step 2, then run ./scripts/setup again."
  echo

  # Project URL: also gives the JWKS URL the API checks sign-ins with.
  url="${SUPABASE_URL:-$(get_env SUPABASE_URL)}"
  while :; do
    [[ -n "$url" ]] || ask url "Project URL (https://<id>.supabase.co)"
    url="${url%/}"
    if [[ "$url" =~ ^https?://[^/]+$ ]] && curl -fsS -m 15 "$url/auth/v1/.well-known/jwks.json" >/dev/null 2>&1; then break; fi
    echo "  Can't reach Supabase Auth at $url. Check the URL (Project Settings -> Data API -> Project URL)."; url=""
  done

  # anon / publishable key: checked against the project.
  anon="${SUPABASE_ANON_KEY:-$(get_env VITE_SUPABASE_ANON_KEY)}"
  while :; do
    [[ -n "$anon" ]] || ask anon "Publishable (or anon) key"
    code="$(curl -s -m 15 -o /dev/null -w '%{http_code}' "$url/auth/v1/settings" -H "apikey: $anon" || true)"
    [[ "$code" == 200 ]] && break
    echo "  Supabase didn't accept that key (HTTP $code). Copy the Publishable key (or the legacy anon key) from Project Settings -> API Keys, not the secret or service_role key."; anon=""
  done

  owner="${AXOM_OWNER_EMAIL:-$(get_env AXOM_OWNER_EMAIL)}"
  while ! [[ "$owner" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]]; do
    ask owner "Your email (the user you created in Supabase)" "$owner"
  done

  set_env SUPABASE_URL "$url"
  set_env VITE_SUPABASE_URL "$url"
  set_env VITE_SUPABASE_ANON_KEY "$anon"
  set_env AXOM_OWNER_EMAIL "$owner"
  # Newer projects sign sessions with keys published here; older ones only
  # with the legacy shared secret.
  if curl -fsS -m 15 "$url/auth/v1/.well-known/jwks.json" | grep -q '"kid"'; then
    set_env SUPABASE_JWKS_URL "$url/auth/v1/.well-known/jwks.json"
  elif [[ -z "$(get_env SUPABASE_JWT_SECRET)" ]]; then
    echo "This project uses the legacy JWT secret: Project Settings -> JWT Keys -> Legacy JWT secret."
    read -r -s -p "Legacy JWT secret (hidden): " secret; echo
    [[ -n "$secret" ]] || fail "The JWT secret is needed to check dashboard sign-ins." "Run ./scripts/setup again when you have it."
    set_env SUPABASE_JWT_SECRET "$secret"
  fi
  say "Saved to .env."
fi

# --- 2. Keys ---------------------------------------------------------------------
# Generated once and kept in .env; never printed.
keygen() {
  if [[ -x "$ROOT/axom/target/debug/axom" ]]; then "$ROOT/axom/target/debug/axom" "$@"
  else docker compose run --rm --no-deps -T axom axom "$@"; fi
}
if [[ -z "$(get_env AXOM_ATTESTATION_SIGNING_KEY)" || -z "$(get_env AXOM_APPROVAL_SIGNING_KEY)" || -z "$(get_env AXOM_SECRETS_KEY)" ]]; then
  step "Generating Combox's keys"
  [[ -x "$ROOT/axom/target/debug/axom" ]] || echo "(building the Combox image first; this takes a few minutes the first time)"
  for kind in ATTESTATION APPROVAL; do
    if [[ -z "$(get_env AXOM_${kind}_SIGNING_KEY)" ]]; then
      out="$(keygen keygen)"
      set_env "AXOM_${kind}_SIGNING_KEY" "$(echo "$out" | grep '^SIGNING_KEY=' | cut -d= -f2-)"
      set_env "AXOM_${kind}_VERIFY_KEY" "$(echo "$out" | grep '^VERIFY_KEY=' | cut -d= -f2-)"
    fi
  done
  # Encrypts integration keys saved on the dashboard (Integrations page).
  [[ -n "$(get_env AXOM_SECRETS_KEY)" ]] || set_env AXOM_SECRETS_KEY "$(keygen secrets-key | grep '^AXOM_SECRETS_KEY=' | cut -d= -f2-)"
  for k in AXOM_ATTESTATION_SIGNING_KEY AXOM_APPROVAL_SIGNING_KEY AXOM_ATTESTATION_VERIFY_KEY AXOM_APPROVAL_VERIFY_KEY AXOM_SECRETS_KEY; do
    [[ -n "$(get_env "$k")" ]] || fail "Generating $k failed." "Run ./scripts/setup again; if it keeps failing, see docs/SETUP.md step 3."
  done
  say "Keys saved to .env. Keep a copy of .env somewhere safe: without AXOM_SECRETS_KEY, saved integration keys can't be read."
fi

# --- 3. Payouts -------------------------------------------------------------------
setup_payouts

# --- 4. Start ---------------------------------------------------------------------
exec "$ROOT/scripts/start"

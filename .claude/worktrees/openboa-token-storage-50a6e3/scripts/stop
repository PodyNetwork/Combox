#!/usr/bin/env bash
# Stop Combox: the demo (./scripts/start demo), including anything a run
# killed without Ctrl+C left behind, and your own Combox in Docker
# (./scripts/start). Your own Combox's data is kept.
#
#   ./scripts/stop
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WEB_PIDS="$ROOT/judge/out/web.pids"

# The demo: its web servers, then the API, signer, OpenBao and Postgres.
if [[ -f "$WEB_PIDS" ]]; then
  while read -r p; do
    [[ "$(ps -p "$p" -o command= 2>/dev/null || true)" == *vite* ]] && kill "$p" 2>/dev/null || true
  done < "$WEB_PIDS"
  rm -f "$WEB_PIDS"
fi
"$ROOT/judge/run.sh" --stop

# Your own Combox (Docker), if it's set up and running.
if [[ -f "$ROOT/.env" ]] && command -v docker >/dev/null && docker info >/dev/null 2>&1 \
  && [[ -n "$(cd "$ROOT" && docker compose --profile payouts ps -q 2>/dev/null)" ]]; then
  # The payouts profile too, so a running signer stops with the rest.
  (cd "$ROOT" && docker compose --profile payouts stop)
fi
printf '\033[1m%s\033[0m\n' "Combox is stopped. Start it again with ./scripts/start (or ./scripts/start demo)."
